# Template pour le fichier .env (qui DOIT rester local, jamais committé).
#
# Marche à suivre :
#   1. cp .env.example .env
#   2. Édite .env avec tes vrais credentials Cardmarket
#   3. Vérifie : git check-ignore .env  (doit renvoyer ".env" → bien ignoré)
#
# Sécurité :
#   - Ce fichier .env contient ton mot de passe en clair sur ton disque.
#   - Si tu utilises un PC partagé, préfère le mode interactif (efface .env
#     et laisse le code redemander chaque fois).
#   - Si MKM affiche un CAPTCHA / 2FA au login, l'auto-fill remplit les
#     champs mais TU dois résoudre le CAPTCHA manuellement.

CARDMARKET_USER=ton_identifiant_mkm
CARDMARKET_PASS=ton_mot_de_passe
